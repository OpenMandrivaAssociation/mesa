diff -Nupr before/src/gallium/targets/dri/gallium_core_dummy.c mesa-26.2.1/src/gallium/targets/dri/gallium_core_dummy.c
--- before/src/gallium/targets/dri/gallium_core_dummy.c	1970-01-01 01:00:00.000000000 +0100
+++ mesa-26.2.1/src/gallium/targets/dri/gallium_core_dummy.c	2026-08-21 20:26:49.444321562 +0200
@@ -0,0 +1,46 @@
+/* Core-side shims used when pipe drivers live in separate *_dri.so files. */
+#include "pipe-loader/pipe_loader_priv.h"
+#include "target-helpers/sw_helper_public.h"
+
+#include <dlfcn.h>
+
+int mesa_gallium_core_dummy;
+
+static void *
+swrast_handle(void)
+{
+   static void *h;
+   if (!h)
+      h = pipe_loader_open_dri("swrast");
+   return h;
+}
+
+struct pipe_screen *
+sw_screen_create_vk(struct sw_winsys *winsys, const struct pipe_screen_config *config, bool sw_vk)
+{
+   static struct pipe_screen *(*fn)(struct sw_winsys *, const struct pipe_screen_config *, bool);
+   if (!fn) {
+      void *h = swrast_handle();
+      if (h)
+         fn = dlsym(h, "sw_screen_create_vk");
+   }
+   return fn ? fn(winsys, config, sw_vk) : NULL;
+}
+
+struct pipe_screen *
+sw_screen_create_zink(struct sw_winsys *winsys, const struct pipe_screen_config *config, bool whatever)
+{
+   static struct pipe_screen *(*fn)(struct sw_winsys *, const struct pipe_screen_config *, bool);
+   if (!fn) {
+      void *h = pipe_loader_open_dri("zink");
+      if (h)
+         fn = dlsym(h, "sw_screen_create_zink");
+   }
+   return fn ? fn(winsys, config, whatever) : NULL;
+}
+
+struct pipe_screen *
+sw_screen_create(struct sw_winsys *winsys)
+{
+   return sw_screen_create_vk(winsys, NULL, false);
+}
