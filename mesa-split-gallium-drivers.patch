@@ -33,8 +33,37 @@
 #include "util/xmlconfig.h"
 #include "util/driconf.h"
 #include "util/perf/cpu_trace.h"
+#include "util/os_misc.h"
 
 #include <string.h>
+#include <stdio.h>
+
+#ifdef HAVE_GALLIUM_SPLIT_DRIVERS
+#include <dlfcn.h>
+#include <limits.h>
+
+void *
+pipe_loader_open_dri(const char *driver_name)
+{
+   const char *search = os_get_option("LIBGL_DRIVERS_PATH");
+   char path[PATH_MAX];
+
+   if (search && search[0]) {
+      snprintf(path, sizeof(path), "%s/%s_dri.so", search, driver_name);
+      void *h = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+      if (h)
+         return h;
+   }
+#ifdef DRI_DRIVER_SEARCH_DIR
+   snprintf(path, sizeof(path), "%s/%s_dri.so", DRI_DRIVER_SEARCH_DIR, driver_name);
+   void *h = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+   if (h)
+      return h;
+#endif
+   snprintf(path, sizeof(path), "%s_dri.so", driver_name);
+   return dlopen(path, RTLD_NOW | RTLD_LOCAL);
+}
+#endif
 
 #ifdef _MSC_VER
 #include <stdlib.h>
