+#ifdef HAVE_GALLIUM_SPLIT_DRIVERS
+static const struct drm_driver_descriptor *
+get_driver_descriptor(const char *driver_name)
+{
+   static struct {
+      char name[32];
+      const struct drm_driver_descriptor *dd;
+   } cache[16];
+   static int ncache;
+
+   for (int i = 0; i < ncache; i++) {
+      if (strcmp(cache[i].name, driver_name) == 0)
+         return cache[i].dd;
+   }
+
+   void *h = pipe_loader_open_dri(driver_name);
+   if (!h)
+      return NULL;
+
+   char sym[64];
+   snprintf(sym, sizeof(sym), "%s_driver_descriptor", driver_name);
+   /* kmsro panel devices (rockchip, ...) have no per-name descriptor. */
+   const struct drm_driver_descriptor *dd = dlsym(h, sym);
+   if (!dd && strcmp(driver_name, "kmsro") != 0) {
+      dd = dlsym(h, "kmsro_driver_descriptor");
+   }
+   if (!dd) {
+      dlclose(h);
+      return NULL;
+   }
+   if (ncache < (int)ARRAY_SIZE(cache)) {
+      snprintf(cache[ncache].name, sizeof(cache[ncache].name), "%s", driver_name);
+      cache[ncache].dd = dd;
+      ncache++;
+   }
+   return dd;
+}
